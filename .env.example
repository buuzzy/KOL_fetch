# YouTube Data API v3 Key
# 申请地址：https://console.cloud.google.com/apis/credentials
# 启用 YouTube Data API v3：https://console.cloud.google.com/apis/library/youtube.googleapis.com
YOUTUBE_API_KEY=your_api_key_here

# TikHub API Key (用于 Instagram 等平台)
# 申请地址：https://user.tikhub.io/
TIKHUB_API_KEY=your_tikhub_api_key_here

# Supabase (Web 中台所需)
# 在 Supabase Dashboard → Settings → API 中获取
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend (邮件发送)
RESEND_API_KEY=your_resend_api_key
RESEND_FROM=onboarding@resend.dev

# 前端生产 API 地址（Cloudflare Pages 构建变量）
VITE_API_BASE_URL=https://your-api.example.com

# DeepSeek LLM 精筛（默认使用 DeepSeek OpenAI 兼容接口）
DEEPSEEK_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# CORS (前端域名，逗号分隔)
CORS_ORIGINS=http://localhost:5173,https://your-app.pages.dev
